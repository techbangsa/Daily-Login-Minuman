# --- Wajib ---
SHOPIFY_STORE_DOMAIN=minumancom.myshopify.com
# Admin API access token (scopes: read/write_customers, write_discounts)
SHOPIFY_ADMIN_API=
# Client secret app (Dev Dashboard -> app -> Settings), untuk verifikasi signature App Proxy
SHOPIFY_API_SECRET=

# --- Opsional (default di src/config.js) ---
# SHOPIFY_API_VERSION=2026-10
# SHOP_TIMEZONE=Asia/Jakarta
# SHOP_CURRENCY=IDR
# LOYALTY_NAMESPACE=custom
# LOYALTY_KEY=loyalty_data
# Poin per hari dalam siklus 7 hari
# REWARD_CYCLE=10,10,15,15,20,20,50
# Tier penukaran: poin -> potongan (IDR), minSubtotal = minimum belanja
# REDEEM_TIERS=[{"id":"pts-100","points":100,"amount":10000,"minSubtotal":100000}]
# HISTORY_LIMIT=30
# VOUCHER_EXPIRY_DAYS=30
# VOUCHER_CODE_PREFIX=MNM
# PROXY_MAX_AGE_SECONDS=300
