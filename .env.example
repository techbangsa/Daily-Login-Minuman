# --- Wajib ---
SHOPIFY_STORE_DOMAIN=minumancom.myshopify.com
# Admin API access token dari app yang SAMA dengan pemilik Flow trigger extension
# (scopes: read_customers, write_customers)
SHOPIFY_ADMIN_API=
# Client secret app (Dev Dashboard -> app -> Settings), untuk verifikasi signature App Proxy
SHOPIFY_API_SECRET=

# Token untuk endpoint mobile app (/mobile/*), dikirim sebagai "Authorization: Bearer <token>".
# Buat dengan: openssl rand -hex 32. Kosong = endpoint mobile nonaktif (503).
MOBILE_API_TOKEN=

# --- Opsional (default di src/config.js) ---
# SHOPIFY_API_VERSION=2026-10
# SHOP_TIMEZONE=Asia/Jakarta
# Metafield penanda check-in (hanya { streak, last_checkin }, tanpa poin)
# LOYALTY_NAMESPACE=custom
# LOYALTY_KEY=loyalty_data
# Poin per hari dalam siklus 7 hari (dikirim ke Growave lewat Flow)
# REWARD_CYCLE=10,10,15,15,20,20,50
# Handle Flow trigger extension (extensions/daily-checkin-completed)
# FLOW_TRIGGER_HANDLE=daily-checkin-completed
# PROXY_MAX_AGE_SECONDS=300
